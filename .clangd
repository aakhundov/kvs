Diagnostics:
  MissingIncludes: Strict
  UnusedIncludes: Strict
  Includes:
    # the .clang-tidy counterpart: glibc's defining headers are inner ones
    # the public header wraps, and not the include to write
    IgnoreHeader: [.*/bits/.*, .*/asm-generic/.*, .*/asm/.*, .*/linux/.*, .*/sys/types.h, .*/sys/poll.h]

InlayHints:
  Enabled: No
