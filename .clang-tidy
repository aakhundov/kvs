Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -readability-identifier-length,
  -readability-implicit-bool-conversion,
  -misc-no-recursion,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling

# our own headers only: vendored third-party code is not ours to lint
HeaderFilterRegex: '.*/kvs/src/.*'
FormatStyle: file

CheckOptions:
  # include-cleaner traces a symbol to the header that defines it, and in
  # glibc that is an inner header the public one wraps: the E* values in
  # asm-generic and asm, the types under bits, and ssize_t and pid_t
  # attributed to <sys/types.h> although <unistd.h> and <sys/socket.h>
  # provide them by POSIX. Ignoring those keeps <errno.h> and the POSIX
  # headers as the ones to write.
  # The cost is measured: a missing <errno.h> is no longer reported here, and
  # is instead 20 compiler errors.
  # The regexes are matched against the full path, hence the leading .*/.
  misc-include-cleaner.IgnoreHeaders: '.*/bits/.*;.*/asm-generic/.*;.*/asm/.*;.*/linux/.*;.*/sys/types.h'
